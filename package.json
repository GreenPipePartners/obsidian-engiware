{
  "name": "obsidian-engiware",
  "version": "0.3.0",
  "private": true,
  "description": "Packaged engineering components and image-first, on-demand 3D previews for Obsidian",
  "license": "MIT",
  "author": "Green Pipe Partners LLC",
  "repository": { "type": "git", "url": "https://github.com/GreenPipePartners/obsidian-engiware.git" },
  "bugs": { "url": "https://github.com/GreenPipePartners/obsidian-engiware/issues" },
  "engines": { "node": ">=22.18.0" },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src --max-warnings 0",
    "demo": "node scripts/build-demo.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "package:release": "node scripts/package-release.mjs",
    "verify": "npm run lint && npm run check && npm test && npm run build && npm run validate:release"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/three": "0.180.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.12.0",
    "obsidian": "1.8.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
